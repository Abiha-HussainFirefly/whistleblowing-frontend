##############################################################################
# Tellara Whistleblowing frontend — environment contract
#
# Copy to `.env` and fill in. Never commit a filled-in copy.
#
# IMPORTANT: every VITE_* value is compiled into the JavaScript bundle and is
# public. Never put a secret, API key or credential here.
##############################################################################

VITE_APP_NAME=Tellara
# development | staging | production
VITE_APP_ENV=development

# Absolute http(s) URL, or a same-origin path when a proxy forwards /api.
VITE_API_BASE_URL=http://localhost:3001/api/v1
VITE_API_TIMEOUT_MS=30000

# Storage namespace for non-sensitive UI preferences.
# The access token is held in memory only and is never written here.
VITE_AUTH_STORAGE_KEY=tellara.auth

# How long before expiry to renew the access token, in seconds.
VITE_TOKEN_REFRESH_THRESHOLD_SECONDS=60

VITE_ENABLE_DEVTOOLS=false
VITE_ENABLE_ANALYTICS=false

# Error reporting. Leave blank to disable.
# PII scrubbing is applied before send: report content, case references and
# identities must never reach the error reporter.
VITE_SENTRY_DSN=

# The organization slug this deployment serves, used on the staff login form.
# Required when the deployment contains more than one organization.
# Public information (it appears in the reporting portal URL), not a secret.
VITE_WB_ORGANIZATION_SLUG=tellara
